# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default)
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration for 2FA OTP
# For Gmail: https://myaccount.google.com/apppasswords (use App Password, not regular password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=MindLift <your-email@gmail.com>

# For development/testing (prints emails to console instead of sending)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# API Keys
YOUTUBE_API_KEY=your-youtube-api-key
GROQ_API_KEY=your-groq-api-key

# Groq Settings
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=500
MAX_CONTEXT_MESSAGES=4
REQUEST_TIMEOUT=30

# Rasa Settings
USE_RASA=False
RASA_SERVER_URL=http://localhost:5005
